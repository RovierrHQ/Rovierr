{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "*": ["./*"],
      "@api/*": ["./src/*"],
      "@web/*": ["../web/src/*"]
    },
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "types": ["@types/bun"]
  }
}
