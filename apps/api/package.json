{
  "name": "api",
  "main": "src/index.ts",
  "type": "module",
  "types": "./src/export-types.ts",
  "exports": {
    ".": {
      "types": "./src/export-types.ts",
      "import": "./dist/export-types.mjs",
      "default": "./dist/export-types.mjs"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc -b",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "NODE_ENV=production tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "stripe:listen": "stripe listen --forward-to localhost:3001/api/stripe/webhook",
    "stripe:trigger:account-updated": "stripe trigger account.updated"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.26",
    "@aws-sdk/client-s3": "3.985.0",
    "@aws-sdk/s3-request-presigner": "^3.985.0",
    "@better-auth/core": "1.4.18",
    "@better-auth/expo": "1.4.18",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/openapi": "^1.4.14",
    "@neondatabase/serverless": "1.0.2",
    "@orpc/client": "1.13.4",
    "@orpc/openapi": "1.13.4",
    "@orpc/server": "1.13.4",
    "@orpc/zod": "1.13.4",
    "@rov/auth": "workspace:*",
    "@rov/db": "workspace:*",
    "@rov/realtime": "workspace:*",
    "@sinclair/typebox": "0.34.48",
    "@tqman/nice-logger": "^1.1.1",
    "ai": "^6.0.75",
    "axios": "^1.13.4",
    "better-auth": "1.4.18",
    "cheerio": "^1.2.0",
    "dotenv": "17.2.4",
    "drizzle-orm": "0.45.1",
    "drizzle-zod": "^0.8.3",
    "elysia": "1.4.22",
    "googleapis": "171.4.0",
    "hono": "4.11.8",
    "hono-pino": "0.10.3",
    "nanoid": "5.1.6",
    "pino": "10.3.0",
    "posthog-node": "5.24.11",
    "stripe": "^20.3.1",
    "usesend-js": "^1.6.0",
    "ws": "8.19.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "8.18.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "0.31.8",
    "fast-check": "4.5.3",
    "typescript": "5.9.3"
  }
}
