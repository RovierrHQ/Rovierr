/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Multi-environment: deploy with -e dev or -e production (e.g. wrangler deploy -e dev).
 * dev → rovierr-web-dev @ dev.rovierr.com
 * production → rovierr-web-production @ rovierr.com
 *
 * Custom domains: zone rovierr.com must be in your Cloudflare account.
 * If dev.rovierr.com has an existing CNAME in DNS, remove it so Wrangler can create the Custom Domain.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rovierr-web",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"observability": { "enabled": true },
	"env": {
		"dev": {
			"routes": [
				{ "pattern": "dev.rovierr.com", "custom_domain": true }
			]
		},
		"production": {
			"routes": [
				{ "pattern": "rovierr.com", "custom_domain": true }
			]
		}
	}
}